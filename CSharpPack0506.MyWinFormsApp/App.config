<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!--
      Connection String فقط در یک نقطه مرکزی نگهداری می شود (قبلا داخل کلاس Business هارد کد شده بود).
      برای محیط واقعی از appsettings.Development.json یا Environment Variable استفاده کنید.
    -->
    <add name="CSharpPack0506DB"
         providerName="Microsoft.Data.SqlClient"
         connectionString="Data Source=.;Database=CSharpPack0506DB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Application Name=&quot;CSharpPack0506.MyWinFormsApp&quot;;Command Timeout=0" />
  </connectionStrings>
</configuration>
